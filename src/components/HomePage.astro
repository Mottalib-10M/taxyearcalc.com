---
/**
 * Home, in its own order for this subject (RECETTE §6.6, rule 2): the ledger of the year's numbers first
 * (2025 against 2026, each line linking its calculator), the folded answer, the bracket calculator, the
 * calendar from today to the 2027 deadline, why the site exists, the long text in accordions, the FAQ.
 * Text: src/content/home.ts.
 */
import PageLayout from '../layouts/PageLayout.astro';
import Clamp from './Clamp.astro';
import Calc from './calc/Calc';
import { HOME } from '../content/home';
import { route } from '../i18n/routes';
import { helpers, SOURCES } from '../lib/helpers';
import { day, P } from '../lib/kit';
import { faqSchema, organizationSchema, websiteSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
import { LAST_UPDATED } from '../data/site-config';
const lang = 'en';
const x = HOME;
const path = route('home', lang);
const h = helpers();
const s = x.sections(h);
const sources = x.sources.map((k) => ({ name: SOURCES[k].label, url: SOURCES[k].url }));
const jsonLd = [websiteSchema(lang), organizationSchema(lang), webPageSchema({ name: x.h1, description: x.description, path, lang }), webApplicationSchema({ name: x.h1, description: x.description, path, lang }), faqSchema(x.faqs, lang)];
const when = (d: string) => (d.length === 7 ? 'January 2027' : day(d));
---
<PageLayout title={x.title} description={x.description} lang={lang} jsonLd={jsonLd} faqs={x.faqs} sources={sources}>
  <header class="mb-6 border-b-4 border-double border-navy-300 pb-5">
    <p class="text-sm font-semibold uppercase tracking-widest text-accent-700">Federal tax year 2026 · return due {day(P.years['2026'].deadlines.filing)}</p>
    <h1 class="mt-2 font-serif text-3xl font-bold text-navy-900 md:text-5xl">{x.h1}</h1>
    <p class="mt-3 text-lg text-navy-700">{x.intro}</p>
    <p class="mt-3 text-sm text-navy-700">Last updated, every figure compared with the IRS documents: <time datetime={LAST_UPDATED}>{day(LAST_UPDATED)}</time> · <a href={route('method', lang)} class="underline">how we calculate</a> · <a href={route('about', lang)} class="underline">who publishes this site</a></p>
  </header>
  <Clamp text={x.resume} lang={lang} id="clamp-home" class="mb-8" />
  <section aria-labelledby="ledger" class="mb-10">
    <h2 id="ledger" class="font-serif text-2xl font-bold text-navy-900">The year in fifteen numbers</h2>
    <p class="mt-2 text-sm text-navy-700">2025 (return filed in 2026) against 2026 (return filed in 2027). Sources: Rev. Proc. 2024-40, Rev. Proc. 2025-32, Notice 2025-67, Rev. Proc. 2024-25 and 2025-19, Public Law 119-21.</p>
    <div class="not-prose mt-3 overflow-x-auto"><table class="journal w-full text-sm">
      <thead><tr><th scope="col" class="px-3 py-2 text-left font-semibold text-navy-900">Figure</th><th scope="col" class="px-3 py-2 text-right font-semibold text-navy-900">2025</th><th scope="col" class="px-3 py-2 text-right font-semibold text-navy-900">2026</th><th scope="col" class="px-3 py-2 text-left font-semibold text-navy-900">Calculator</th></tr></thead>
      <tbody>{s.ledger.map((r) => <tr><td class="border-b border-navy-100 px-3 py-2 text-navy-800">{r[0]}</td><td class="tabular-nums border-b border-navy-100 px-3 py-2 text-right text-navy-700">{r[1]}</td><td class="tabular-nums border-b border-navy-100 px-3 py-2 text-right font-semibold text-navy-900">{r[2]}</td><td class="border-b border-navy-100 px-3 py-2"><Fragment set:html={r[3]} /></td></tr>)}</tbody>
    </table></div>
  </section>
  <section aria-labelledby="where" class="mb-10">
    <h2 id="where" class="mb-4 font-serif text-2xl font-bold text-navy-900">Where your 2026 income lands</h2>
    <Calc client:load kind="brackets" methodHref={route('method', lang)} idPrefix="home" />
  </section>
  <section aria-labelledby="cal" class="mb-10">
    <h2 id="cal" class="font-serif text-2xl font-bold text-navy-900">From now to the April 2027 deadline</h2>
    <ol class="mt-4 border-l-2 border-accent-600 pl-5">
      {s.calendar.map((c) => <li class="mb-4"><p class="font-semibold text-navy-900">{when(c[0])}</p><p class="text-navy-800">{c[1]} <Fragment set:html={c[2]} /></p></li>)}
    </ol>
  </section>
  <section aria-labelledby="why" class="prose prose-slate mb-10 max-w-none prose-headings:font-serif">
    <h2 id="why">Why work the numbers here instead of reading another article</h2>
    <Fragment set:html={s.why} />
  </section>
  <div class="prose prose-slate max-w-none prose-headings:font-serif">
    {s.long.map(([t, body]) => <details class="fold"><summary><h2 class="fold-h">{t}</h2></summary><Fragment set:html={body} /></details>)}
  </div>
</PageLayout>
